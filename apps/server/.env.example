# Voxit 服务端环境变量
# 复制为 .env 后按需填写

# 服务端口
PORT=3100

# ===== 数据目录（部署必填）=====
# 数据库文件（voxit.db）、导出音频、临时文件都存这里。
# 部署时务必设置，否则 dev（src/data）与构建后（dist/data）是两份数据。
# 例如：DATA_DIR=/var/lib/voxit
# DATA_DIR=

# ===== 管理员登录（部署必填）=====
# 前端登录页使用的账号密码
ADMIN_USER=admin
ADMIN_PASS=请设置一个强密码
# JWT 签名密钥（务必修改为随机长字符串，可用 `openssl rand -hex 32` 生成）
JWT_SECRET=change-me-to-a-long-random-string
# token 有效期，如 7d / 24h / 1h
JWT_EXPIRES=7d

# ===== CORS 白名单（逗号分隔）=====
# 前端实际部署域名，本地开发默认 5173
CORS_ORIGINS=http://localhost:5173

# ===== 阿里云百炼（北京地域）=====
# 从 https://bailian.console.aliyun.com 获取
ALIYUN_API_KEY=sk-your-aliyun-api-key
ALIYUN_WORKSPACE_ID=your-workspace-id

# ===== 火山引擎豆包 =====
# 从 https://console.volcengine.com/ 语音技术控制台获取
DOUBAO_APP_ID=your-doubao-appid
DOUBAO_TOKEN=your-doubao-access-token
DOUBAO_CLUSTER=volcano_tts
