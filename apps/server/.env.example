# Voxit 服务端环境变量
# 复制为 .env 后按需填写

# 服务端口
PORT=3100

# ===== 数据目录（部署必填）=====
# 数据库文件（voxit.db）、导出音频、临时文件都存这里。
# 部署时务必设置，否则 dev（src/data）与构建后（dist/data）是两份数据。
# 例如：DATA_DIR=/var/lib/voxit
# DATA_DIR=

# ===== 管理员登录（部署必填）=====
# 前端登录页使用的账号密码
ADMIN_USER=admin
ADMIN_PASS=请设置一个强密码
# JWT 签名密钥（务必修改为随机长字符串，可用 `openssl rand -hex 32` 生成）
JWT_SECRET=change-me-to-a-long-random-string
# token 有效期，如 7d / 24h / 1h
JWT_EXPIRES=7d

# ===== CORS 白名单（逗号分隔）=====
# 前端实际部署域名，本地开发默认 5173
CORS_ORIGINS=http://localhost:5173

# ===== 阿里云百炼（北京地域）=====
# 从 https://bailian.console.aliyun.com 获取
ALIYUN_API_KEY=sk-your-aliyun-api-key
ALIYUN_WORKSPACE_ID=your-workspace-id
# 默认合成模型（可选），前端仍可选择其它模型
# 可选值：cosyvoice-v3-flash / cosyvoice-v3-plus / cosyvoice-v3.5-flash / cosyvoice-v3.5-plus / cosyvoice-v2 / qwen-tts / qwen3-tts-flash / qwen3-tts-instruct-flash / ...
ALIYUN_MODEL=cosyvoice-v3-flash

# ===== 豆包火山引擎（新版鉴权：单个 API Key，V3 豆包语音合成 2.0）=====
# 新版控制台 → 豆包语音 → 「API管理」页面创建/复制 API Key
# （https://console.volcengine.com/，顶部搜索「豆包语音」进入）
DOUBAO_API_KEY=your-doubao-api-key
# 语音模型资源 ID（X-Api-Resource-Id），豆包语音合成 2.0 为 seed-tts-2.0
DOUBAO_RESOURCE_ID=seed-tts-2.0
